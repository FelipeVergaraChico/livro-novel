{
  "name": "livronovel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "dev:lan": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "vue-tsc --noEmit && vite build && tsc -p tsconfig.server.json && cp server/schema.sql dist/server/schema.sql",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:production": "node scripts/smoke-production.mjs",
    "format": "prettier --write .",
    "db:migrate": "node --env-file-if-exists=.env --import tsx server/migrate.ts",
    "check": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/libre-caslon-display": "^5.3.0",
    "cheerio": "^1.1.2",
    "cookie-parser": "^1.4.7",
    "domhandler": "^5.0.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "fast-xml-parser": "^5.3.0",
    "helmet": "^8.1.0",
    "idb-keyval": "^6.2.2",
    "lucide-vue-next": "^0.468.0",
    "mammoth": "^1.11.0",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "sanitize-html": "^2.17.0",
    "vue": "^3.5.22",
    "yauzl": "^3.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^6.0.3",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "jszip": "^3.10.2",
    "prettier": "^3.9.10",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1"
  }
}
